    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/graphql": "^13.1.0",
    "@nestjs/mongoose": "^11.0.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/schedule": "^6.1.3",
    "fast-xml-parser": "^4.5.0",
    "graphql": "^16.10.0",
    "joi": "^17.13.0",
    "mongoose": "^8.9.0",
    "nestjs-pino": "^4.3.0",
    "pino-http": "^10.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
